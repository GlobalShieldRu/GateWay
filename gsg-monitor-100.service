[Unit]
Description=GSG per-device traffic monitor (10.10.1.100)
Documentation=https://github.com/GlobalShieldRu/GateWay
After=docker.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gsg-monitor-100.sh 10.10.1.100
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
